    "@rlmartin-projen/projen-project": "~0",
    "cdktn": "~0",
    "constructs": "~10",
    "liquidjs": "~10",
    "projen": "~0"
  },
  "bundledDependencies": [
    "@cdktn/provider-archive",
    "@cdktn/provider-aws",
    "liquidjs"
